# Виртуальное окружение (зависимости устанавливаются в контейнере)
venv/
env/
ENV/

# Секреты (передаются через environment variables)
.env
.env.local

# Git репозиторий (не нужен для работы бота)
.git/
.gitignore

# Python кэш (пересоздастся в контейнере)
__pycache__/
*.pyc
*.pyo

# Данные пользователей (монтируются через volume)
user_data.json

# Служебные директории
.claude/
.vscode/
.idea/
