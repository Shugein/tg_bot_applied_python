# Telegram Bot Token (получить у @BotFather)
BOT_TOKEN=your_bot_token_here

# OpenWeather API Key (получить на https://openweathermap.org/api)
OPENWEATHER_API_KEY=your_openweather_key_here

# LLM API Key для OpenRouter (получить на https://openrouter.ai/)
LLM_API_KEY=your_llm_api_key_here

# Опционально: URL бота
BOT_URL=https://t.me/your_bot_name

# Опционально: путь к файлу данных
USER_DATA_FILE=user_data.json
